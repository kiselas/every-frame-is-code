  "facts": [
    { "id": "f-dict", "text": "The 1954 edition of the Brief Philosophical Dictionary defined cybernetics as a reactionary pseudoscience (the film shows only the stamped word and the dictionary's title)", "source": "https://computer-museum.ru/articles/aleksey-andreevich-lyapunov-ocherk-zhizni-i-tvorchestva-okruzhenie-i-lichnost/270/" },
    { "id": "f-life", "text": "Born 25 Sep (8 Oct) 1911 in Moscow; died 23 Jun 1973 in Moscow", "source": "https://ru.wikipedia.org/wiki/Ляпунов,_Алексей_Андреевич" },
    { "id": "f-luzin", "text": "A student of N. N. Luzin from 1932", "source": "https://www.computer-museum.ru/galglory/lypunov2.htm" },
    { "id": "f-redstar", "text": "Commander of a topographic platoon in the artillery; Order of the Red Star, 1944", "source": "https://ru.wikipedia.org/wiki/Ляпунов,_Алексей_Андреевич" },
    { "id": "f-course", "text": "In 1952-53, invited by S. L. Sobolev, he gave the first programming course in the country at Moscow University", "source": "https://letopis.msu.ru/peoples/8675" },
    { "id": "f-operator", "text": "He described the solution of a problem as a scheme of arithmetic and control operators and logical conditions; a \"programming program\" was to turn it into machine code", "source": "https://www.computer-museum.ru/galglory/lypunov2.htm" },
    { "id": "f-seminar", "text": "The seminar \"Automata and thinking\" at the Mech-Math faculty, 1954 to 1964", "source": "https://ru.wikipedia.org/wiki/Ляпунов,_Алексей_Андреевич" },
    { "id": "f-article", "text": "\"Osnovnye cherty kibernetiki\" (Sobolev, Kitov, Lyapunov), Voprosy filosofii no. 4, 1955: the first positive article about cybernetics in the USSR", "source": "https://kitov.rea.ru/pervaa-pozitivnaa-stata-o-kibernetike" },
    { "id": "f-council", "text": "The Council on Cybernetics under the Academy of Sciences, 1959; chairman A. I. Berg, deputy A. A. Lyapunov", "source": "https://www.computer-museum.ru/galglory/lypunov2.htm" },
    { "id": "f-students", "text": "Listed as his students: Ershov, Zhuravlev, Lupanov, Ketkov, Fedotov", "source": "https://ru.wikipedia.org/wiki/Ляпунов,_Алексей_Андреевич" }
